# ─────────────────────────────────────────────────────────────────
# Muqsit Platform — Environment variables reference
# ─────────────────────────────────────────────────────────────────
#
# Copy to `.env.local` for local development.
# In Vercel, set these per environment (Test / UAT / Live).
#
# Variables marked [MVP] are needed before the first office can use
# the system. Variables marked [BETA] are deferred to the Beta phase
# (see docs/Muqsit_BRS_v1.0.md §12).

# ── Public (NEXT_PUBLIC_*) — exposed to the browser ─────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=local        # local | test | uat | production


# ── docker-compose defaults (used by local Postgres + Redis) ───

POSTGRES_USER=muqsit
POSTGRES_PASSWORD=muqsit
POSTGRES_DB=muqsit
POSTGRES_PORT=5432
REDIS_PORT=6379


# ─────────────────────────────────────────────────────────────────
# [MVP]  Required before first office can use the system
# ─────────────────────────────────────────────────────────────────

# Database — PostgreSQL connection string.
# Local dev: `docker compose up postgres` then use this URL.
# Production: Vercel Postgres, Neon, Supabase, or RDS.
DATABASE_URL=postgresql://muqsit:muqsit@localhost:5432/muqsit?schema=public

# Auth — 32+ char random secret used to sign session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32-chars

# ZATCA — VAT number on issued invoices.
# Until ZATCA registration: use the placeholder below for Test/UAT.
# Production: replace with the real 15-digit VAT number.
MUQSIT_VAT_NUMBER=300000000000003


# ─────────────────────────────────────────────────────────────────
# [BETA]  Deferred until Beta / pre-production phase
# ─────────────────────────────────────────────────────────────────
# Leaving these unset enables the built-in mock providers, which
# return realistic-looking responses so every UI flow works
# end-to-end without external services.

# Anthropic — Smart chat assistant + OCR (Claude Vision).
# When unset: the chat falls back to keyword-matched canned replies,
# and OCR returns plausible mock fields.
# ANTHROPIC_API_KEY=

# WhatsApp Business (Meta Cloud API).
# When unset: outgoing messages are logged to the console.
# WHATSAPP_PHONE_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v22.0

# SMS Gateway (Unifonic — Saudi licensed provider).
# When unset: outgoing SMS are logged to the console + OTP code
# is returned in the API response (devCode) when NODE_ENV !== production.
# UNIFONIC_APP_SID=
# UNIFONIC_SENDER=Muqsit
# UNIFONIC_CALLBACK_URL=

# Payment Gateway (Moyasar).
# When unset: payments succeed instantly with a synthetic intent id
# so checkout flow runs end-to-end.
# MOYASAR_API_KEY=
# MOYASAR_WEBHOOK_SECRET=
